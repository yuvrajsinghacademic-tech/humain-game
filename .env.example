# hum(ai)n — environment template
# Copy to .env.local for local development. NEVER commit .env.local.
# Every value below is intentionally empty. Do not put real secrets in this file.

# ---------------------------------------------------------------------------
# OpenAI (server-only). Used for: 1 calibration interpretation, up to 15 round
# predictions, 1 debrief = 17 calls maximum per complete game.
# There is deliberately no NEXT_PUBLIC_ variant. The key must never reach a browser bundle.
# ---------------------------------------------------------------------------
OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# Sealed-prediction secret. Used to derive the AES-256-GCM key that seals each
# prediction envelope and the HMAC key that signs the session cookie.
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Minimum 32 characters. Rotating it invalidates in-flight sealed tickets (harmless).
# ---------------------------------------------------------------------------
GAME_SEAL_SECRET=

# ---------------------------------------------------------------------------
# Upstash Redis — durable rate limiting, per-game quotas, global spend ceiling
# and prediction idempotency. Required in production for any paid OpenAI call.
# Without these in production the app FAILS CLOSED: no paid calls are made and
# the game silently falls back to the local behavioral engine.
# ---------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---------------------------------------------------------------------------
# Hard ceiling on total OpenAI calls per UTC day across all players.
# Once reached, the game keeps running on the local behavioral engine.
# Defaults to 2000 when unset.
# ---------------------------------------------------------------------------
GLOBAL_DAILY_OPENAI_CALL_LIMIT=

# ---------------------------------------------------------------------------
# Set to "true" to run the entire game with the deterministic mock AI and make
# zero paid calls. Automatically enabled when OPENAI_API_KEY is absent.
# Used by the Playwright suite. Leave empty in production.
# ---------------------------------------------------------------------------
MOCK_AI=

# ---------------------------------------------------------------------------
# Test-only. Allows ?seed=<int> in the URL to seed the client-side game RNG so
# the end-to-end test is deterministic. Never enable in production.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_ALLOW_SEED=

# ---------------------------------------------------------------------------
# Public contact address shown on /privacy, /privacy-choices and /terms.
# NEXT_PUBLIC_ because it is meant to be read by visitors, not kept secret.
# While unset, those pages say plainly that no address has been published yet
# rather than printing a placeholder. Set this before enabling advertising.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_CONTACT_EMAIL=

# ---------------------------------------------------------------------------
# Google AdSense. All three are public values printed into the ad tag itself.
#
# With NEXT_PUBLIC_ADSENSE_CLIENT_ID unset: no ad script loads, no request is
# made to any Google host, every AdSlot renders nothing, and the
# Content-Security-Policy is byte-identical to the ad-free one.
#
# /ads.txt is NOT gated on this. It names the verified account from
# src/lib/ads/verification.ts, because authorising a seller and serving an ad
# are separate acts and the record is read before any ad runs.
#
# Format is validated, so a half-pasted value disables advertising rather than
# shipping a broken tag: ca-pub-<digits> for the client, digits for a slot.
# See docs/MONETIZATION.md for what has to happen in the AdSense account first.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
NEXT_PUBLIC_ADSENSE_SLOT_EDITORIAL=
NEXT_PUBLIC_ADSENSE_SLOT_POSTGAME=

# ---------------------------------------------------------------------------
# Development only. Set to "true" to draw an empty labelled outline where an ad
# would sit, so the spacing around it can be judged before an AdSense account
# exists. Loads nothing and contacts nobody. Ignored in production builds.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_AD_PLACEHOLDERS=
