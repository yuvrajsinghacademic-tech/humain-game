# hum(ai)n — environment template
# Copy to .env.local for local development. NEVER commit .env.local.
# Every value below is intentionally empty. Do not put real secrets in this file.

# ---------------------------------------------------------------------------
# OpenAI (server-only). Used for: 1 calibration interpretation, up to 15 round
# predictions, 1 debrief = 17 calls maximum per complete game.
# There is deliberately no NEXT_PUBLIC_ variant. The key must never reach a browser bundle.
# ---------------------------------------------------------------------------
OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# Sealed-prediction secret. Used to derive the AES-256-GCM key that seals each
# prediction envelope and the HMAC key that signs the session cookie.
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Minimum 32 characters. Rotating it invalidates in-flight sealed tickets (harmless).
# ---------------------------------------------------------------------------
GAME_SEAL_SECRET=

# ---------------------------------------------------------------------------
# Upstash Redis — durable rate limiting, per-game quotas, global spend ceiling
# and prediction idempotency. Required in production for any paid OpenAI call.
# Without these in production the app FAILS CLOSED: no paid calls are made and
# the game silently falls back to the local behavioral engine.
# ---------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---------------------------------------------------------------------------
# Hard ceiling on total OpenAI calls per UTC day across all players.
# Once reached, the game keeps running on the local behavioral engine.
# Defaults to 2000 when unset.
# ---------------------------------------------------------------------------
GLOBAL_DAILY_OPENAI_CALL_LIMIT=

# ---------------------------------------------------------------------------
# Set to "true" to run the entire game with the deterministic mock AI and make
# zero paid calls. Automatically enabled when OPENAI_API_KEY is absent.
# Used by the Playwright suite. Leave empty in production.
# ---------------------------------------------------------------------------
MOCK_AI=

# ---------------------------------------------------------------------------
# Test-only. Allows ?seed=<int> in the URL to seed the client-side game RNG so
# the end-to-end test is deterministic. Never enable in production.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_ALLOW_SEED=
